# PULSE environment
# ------------------------------------------------------------------
# Data source toggle. "true" (default) runs the app fully on the
# localStorage-backed mock services in lib/services/mock.
# Set to "false" once real implementations are wired in lib/services.
NEXT_PUBLIC_USE_MOCK=true

# Base URL for the future real API (unused while USE_MOCK=true).
NEXT_PUBLIC_API_BASE_URL=

# --- Anticipated for the real backend (all unused in mock mode) ---
# DATABASE_URL=
# AUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_CONNECT_WEBHOOK_SECRET=

# PULSE environment
# ==================================================================
# Copy to .env.local and restart the dev server after changing anything here.

# ------------------------------------------------------------------
# Data source toggle — the whole backend switch.
#
#   true  (default) → lib/services/mock. Everything in localStorage.
#                     No accounts, no network, works offline, and
#                     Settings → "Reset demo data" reseeds it.
#   false           → lib/services/supabase. Real Postgres, RLS, auth,
#                     atomic booking RPCs and realtime.
#
# The UI is identical either way; no component code changes.
NEXT_PUBLIC_USE_MOCK=true

# ------------------------------------------------------------------
# Supabase (only needed when NEXT_PUBLIC_USE_MOCK=false)
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by `npm run db:seed`; NEVER expose this to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Demo accounts created by the seed, so the app's one-tap role picker keeps
# working against real auth. Change these before making a project public.
NEXT_PUBLIC_DEMO_MEMBER_EMAIL=demo.member@pulse.fit
NEXT_PUBLIC_DEMO_OWNER_EMAIL=demo.owner@pulse.fit
NEXT_PUBLIC_DEMO_PASSWORD=pulse-demo-2026

# ------------------------------------------------------------------
# Direct Postgres connection, for migrations and type generation.
# Supabase dashboard → Project Settings → Database → Connection string.
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# --- Not used yet; the seams are documented in the README ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
